{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pixel-stickers",
  "main": "src/index.js",
  "compatibility_date": "2025-11-01",

  // Static site (public/) is served directly; only /api/* and /img/* run the Worker.
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*", "/img/*"]
  },

  "r2_buckets": [
    {
      "binding": "STICKERS",
      "bucket_name": "webdav"
    }
  ],

  "vars": {
    // Folder inside the bucket that holds the images. Must end with "/".
    "STICKER_PREFIX": "content/stickers/"
  }
}
